DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/supply_chain
JWT_SECRET_KEY=change-me-in-production-minimum-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
PROVIDER_KEY_ENCRYPTION_SECRET=change-me-provider-key-secret-min-32-chars!
CBE_ACCOUNT_HOLDER=change-me-to-the-cbe-account-holder
CBE_ACCOUNT_NUMBER=change-me-to-the-cbe-account-number
DASHEN_ACCOUNT_HOLDER=change-me-to-the-dashen-account-holder
DASHEN_ACCOUNT_NUMBER=change-me-to-the-dashen-account-number
BLOCKED_PUBLIC_EMAIL_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,live.com,icloud.com,aol.com,proton.me,protonmail.com
# Include every browser origin that calls the API. In production this must
# include the live product-web origin unless you override it in the deployment.
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5174,http://127.0.0.1:8081,https://product-web-chi.vercel.app,https://ops-console-azure.vercel.app
ALLOWED_HOSTS=platform-api-smoky.vercel.app,product-web-chi.vercel.app,ops-console-azure.vercel.app,localhost,127.0.0.1,testserver
APP_ENV=development
LOG_LEVEL=INFO
