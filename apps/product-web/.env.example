# Public site URL used in metadata/OG tags.
NEXT_PUBLIC_SITE_URL=https://freightpilot.com

# Contact form email relay (formsubmit.co) — plain email relay into a human inbox, no CRM.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/your-team-email@company.com

# Desktop shell download center (footer "Resources" link only — never a primary CTA).
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://example.com/download

# Documentation links (footer "Resources" links only).
NEXT_PUBLIC_DOCS_URL=https://example.com/docs

# Post-signup redirect target: /launch success assigns the browser here.
# Required in deployed environments; do not leave blank in Vercel, or signup
# success will redirect the browser to the local-development fallback.
# The ops console bootstraps the session from the supply_chain_token cookie
# (AuthContext -> /auth/me -> /) when same-site, otherwise lands on its /login.
NEXT_PUBLIC_APP_CONSOLE_URL=http://localhost

# Platform API base URL — the ONLY signup path. POST /auth/company-signup
# provisions the workspace AND triggers server-side sample-data seeding.
# Required in deployed environments; do not leave blank in Vercel, or the
# launch page falls back to the visitor's own localhost:8000.
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8000/api/v1

# NB-74 privacy-light analytics (optional). Leave BOTH unset to render no
# analytics at all — which is the default and the correct local-dev behaviour.
# Supported providers are cookieless and aggregate-only (Plausible, Umami).
# Never point NEXT_PUBLIC_ANALYTICS_SRC at an ad network.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=freightpilot.com
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js