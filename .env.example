# Root environment defaults
POSTGRES_DB=supply_chain
POSTGRES_USER=postgres
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))". Never commit a real value.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/supply_chain
BACKEND_PORT=8000
FRONTEND_PORT=80
PRODUCT_WEB_PORT=8081

# REQUIRED in non-dev. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))". Never commit a real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# REQUIRED in non-dev. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))". Never commit a real value.
PROVIDER_KEY_ENCRYPTION_SECRET=
CBE_ACCOUNT_HOLDER=change-me-to-the-cbe-account-holder
CBE_ACCOUNT_NUMBER=change-me-to-the-cbe-account-number
DASHEN_ACCOUNT_HOLDER=change-me-to-the-dashen-account-holder
DASHEN_ACCOUNT_NUMBER=change-me-to-the-dashen-account-number
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5174,http://127.0.0.1:8081
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
APP_ENV=production
LOG_LEVEL=INFO
PROOF_ORG_QUOTA_BYTES=262144000
RECEIPT_EXTRACTION_MODE=zero_confidence
RECEIPT_EXTRACTION_BASE_URL=https://api.openai.com/v1
RECEIPT_EXTRACTION_MODEL=gpt-4o-mini

SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_NAME=FreightPilot

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FreightPilot
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
