# Root environment defaults
POSTGRES_DB=supply_chain
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/supply_chain
BACKEND_PORT=8000
FRONTEND_PORT=80
PRODUCT_WEB_PORT=8081

JWT_SECRET_KEY=change-me-in-production-minimum-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
APP_ENV=production
LOG_LEVEL=INFO
